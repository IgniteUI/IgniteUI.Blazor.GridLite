<Project>

  <!-- Repo-wide MSBuild targets — intentionally empty. Being present stops MSBuild from importing a
       Directory.Build.targets from above the repo. The library's static web assets (the wwwroot/js bundle
       and the theme CSS) are produced by `npm run build`, which the library project runs from its own build
       unless RunNodeBuild=false — CI and the release workflow build the assets in an explicit npm step first. -->

</Project>
