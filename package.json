{
  "name": "blazor-gridlite",
  "private": true,
  "description": "Ignite UI GridLite Blazor wrapper",
  "author": "",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "watch": "vite build --watch",
    "dev": "vite build --watch --mode development",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "git config core.hooksPath .githooks"
  },
  "lint-staged": {
    "*.{js,ts,json,yml,yaml,css}": "prettier --write"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "6.0.1",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.5",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "igniteui-grid-lite": "~0.11.0"
  }
}
