@page "/"
@using IgniteUI.Blazor.GridLite.TestBed.Components.Models

<h1>GridLite TestBed</h1>

<IgbGridLite @ref="grid" TItem="NwindDataItem" Data="data" Filtering="OnFiltering" Filtered="filtered" data-testid="test-grid">
    <IgbGridLiteColumn Field="@nameof(NwindDataItem.ProductID)"
                       Header="ID"
                       DataType="GridLiteColumnDataType.Number" />
    <IgbGridLiteColumn Field="@nameof(NwindDataItem.ProductName)"
                       Header="Product Name"
                       Sortable Filterable />
    <IgbGridLiteColumn Field="@nameof(NwindDataItem.UnitPrice)"
                       Header="Unit Price"
                       DataType="GridLiteColumnDataType.Number"
                       Sortable />
    <IgbGridLiteColumn Field="@nameof(NwindDataItem.UnitsInStock)"
                       Header="Units In Stock"
                       DataType="GridLiteColumnDataType.Number" />
</IgbGridLite>

<p id="last-filtering">@lastFiltering</p>

<button id="navigate-button" @onclick="@(() => grid.NavigateToAsync(3, activate: true))">Navigate</button>

<button id="bind-filtered-button" @onclick="BindFiltered">Bind Filtered</button>
<p id="filtered-bound">@filtered.HasDelegate</p>
<p id="filtered-count">@filteredCount</p>

@code {
    private readonly GridData data = new();
    private IgbGridLite<NwindDataItem> grid = null!;
    private EventCallback<IgbGridLiteFilteredEventArgs> filtered;
    private string lastFiltering = "none";
    private int filteredCount;

    private void BindFiltered() => filtered = EventCallback.Factory.Create<IgbGridLiteFilteredEventArgs>(this, OnFiltered);

    private void OnFiltered(IgbGridLiteFilteredEventArgs args) => filteredCount++;

    private void OnFiltering(IgbGridLiteFilteringEventArgs args)
        => lastFiltering = $"{args.Type} {string.Join(", ", args.Expressions.Select(e => e.Condition))}";
}
