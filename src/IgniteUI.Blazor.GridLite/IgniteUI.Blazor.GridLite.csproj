<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- Custom props -->
    <RunNodeBuild>true</RunNodeBuild>
  </PropertyGroup>

  <PropertyGroup>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>IgniteUI.Blazor.GridLite</PackageId>
    <Description>Ignite UI GridLite Blazor wrapper</Description>
    <Authors>Infragistics</Authors>
    <PackageTags>Blazor Grid IgniteUI Lite OSS</PackageTags>
    <RootNamespace>IgniteUI.Blazor.Controls</RootNamespace>

    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://www.infragistics.com/products/ignite-ui-blazor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/IgniteUI/IgniteUI.Blazor.GridLite</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="wwwroot\css\themes\.gitkeep" />
    <Content Remove="wwwroot\js\.gitkeep" />
    <None Include="wwwroot\css\themes\.gitkeep" />
    <None Include="wwwroot\js\.gitkeep" />

    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\LICENSE">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>


  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>


  <!-- The npm project lives at the repository root. -->
  <PropertyGroup>
    <RepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..'))</RepoRoot>
  </PropertyGroup>

  <!-- Ensure JavaScript bundle is built before compilation -->
  <Target Name="EnsureNodeModules" BeforeTargets="BuildJavaScriptBundle">
    <PropertyGroup>
      <NodeModulesPath>$(RepoRoot)node_modules</NodeModulesPath>
    </PropertyGroup>
    <Exec Command="npm install" WorkingDirectory="$(RepoRoot)" Condition="!Exists('$(NodeModulesPath)')" />
  </Target>

  <Target Name="BuildJavaScriptBundle" BeforeTargets="BeforeBuild" Condition="'$(RunNodeBuild)' == 'true'">
    <Exec Command="npm run build" WorkingDirectory="$(RepoRoot)" />
  </Target>

  <!-- Optional: Clean JavaScript build output -->
  <Target Name="CleanJavaScriptBundle" AfterTargets="Clean">
    <Delete Files="$(MSBuildProjectDirectory)/wwwroot/js/blazor-igc-grid-lite.js" />
    <Delete Files="$(MSBuildProjectDirectory)/wwwroot/js/blazor-igc-grid-lite.js.map" />
  </Target>

</Project>
