<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>IgniteUI.Blazor.GridLite</PackageId>
    <Description>Ignite UI GridLite Blazor wrapper</Description>
    <Authors>Infragistics</Authors>
    <PackageTags>Blazor Grid IgniteUI Lite OSS</PackageTags>
    <RootNamespace>IgniteUI.Blazor.Controls</RootNamespace>

    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://www.infragistics.com/products/ignite-ui-blazor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/IgniteUI/IgniteUI.Blazor.GridLite</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Ships the XML docs next to the assembly in the package, for IntelliSense; also lets IDE0005 run at build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Trim/single-file/AOT diagnostics build as errors (.editorconfig category rules); suppression policy: docs/TRIMMING.md.
         The public IsAotCompatible claim waits: the Data items are serialized with reflection, and Blazor itself is
         not AOT-compatible yet (Microsoft.AspNetCore.Components ships IsTrimmable only; dotnet/aspnetcore#51598) -
         replace these three with <IsAotCompatible>true</IsAotCompatible> when both change. -->
    <IsTrimmable>true</IsTrimmable>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <!-- Adds the branch to the nuspec's repository element; the url comes from RepositoryUrl above and the
       commit from Source Link, with or without it. -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\LICENSE">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <!-- Written by `npm run build` (vite build.license): every bundled JS dependency's license. Pack runs in the
         outer multi-target build, where the SDK's default None glob is not evaluated, so the file is added explicitly. -->
    <None Remove="THIRD-PARTY-LICENSES.md" />
    <None Include="THIRD-PARTY-LICENSES.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>


  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

  <ItemGroup Condition="'$(ExposeInternalsToTests)' != 'false'">
    <InternalsVisibleTo Include="IgniteUI.Blazor.GridLite.Tests" />
  </ItemGroup>


  <!-- The JS bundle, the theme CSS and THIRD-PARTY-LICENSES.md come from `npm ci` and `npm run build` at the repository
       root, run as their own step (README "Build", ci.yml, publish.yml), so a .NET build never rebuilds the JS from a
       different state than the one that was tested. Building them from here instead, kept for reference: in a
       multi-targeted build these run the npm build once in the outer build and the parallel inner builds find its
       outputs up to date; BeforeTargets hooks run even when the hooked target's condition is false, hence the
       repeated RunNodeBuild conditions.

  <PropertyGroup>
    <RunNodeBuild>true</RunNodeBuild>
    <RepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..'))</RepoRoot>
  </PropertyGroup>

  <Target Name="EnsureNodeModules" BeforeTargets="BuildJavaScriptBundle" Condition="'$(RunNodeBuild)' == 'true'">
    <PropertyGroup>
      <NodeModulesPath>$(RepoRoot)node_modules</NodeModulesPath>
    </PropertyGroup>
    <Exec Command="npm install" WorkingDirectory="$(RepoRoot)" Condition="!Exists('$(NodeModulesPath)')" />
  </Target>

  <Target Name="BuildJavaScriptBundle" BeforeTargets="DispatchToInnerBuilds;BeforeBuild" Condition="'$(RunNodeBuild)' == 'true'"
          Inputs="$(RepoRoot)package.json;$(RepoRoot)package-lock.json;$(RepoRoot)vite.config.js;igc-grid-lite-entry.js"
          Outputs="wwwroot/js/blazor-igc-grid-lite.js;THIRD-PARTY-LICENSES.md">
    <Exec Command="npm run build" WorkingDirectory="$(RepoRoot)" />
  </Target>

  <Target Name="CleanJavaScriptBundle" AfterTargets="Clean" Condition="'$(RunNodeBuild)' == 'true'">
    <Delete Files="wwwroot/js/blazor-igc-grid-lite.js;wwwroot/js/blazor-igc-grid-lite.js.map;THIRD-PARTY-LICENSES.md" />
  </Target>
  -->

</Project>
